# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# --- Adzuna (faixa salarial) -------------------------------------------------
# Crie as credenciais em https://developer.adzuna.com (gratuito para avaliação).
# Sem estas variáveis, /api/salary devolve dados de exemplo.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- IA ----------------------------------------------------------------------
# As API keys de IA NÃO ficam aqui: cada usuário digita a própria chave na
# interface (OpenAI, Anthropic, Gemini, Together ou OpenRouter).
#
# Enquanto a integração real não estiver testada, as rotas devolvem dados de
# exemplo. Para ligar as chamadas reais de IA (e a validação real da chave):
MATCHCV_ENABLE_AI=false

# --- Rate limit (opcional) ---------------------------------------------------
# Sem estas variáveis o limite por IP fica em memória, nesta instância.
# Crie o Redis no Marketplace da Vercel (Upstash) e conecte ao projeto.
# A integração preenche KV_REST_API_URL e KV_REST_API_TOKEN. O par
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN também serve, se o
# par KV_* não estiver completo. Os dois pares não são misturados.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Sal opcional do SHA-256 do IP. Sem ele o IP ainda é hasheado, só que sem sal.
# RATE_LIMIT_IP_SALT=

# --- Telemetria (opcional) ---------------------------------------------------
# Os spans sobem para a observabilidade da Vercel sem estas variáveis.
# O exporter do Langfuse só liga se as três existirem. Sem uma delas, fica desligado.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASEURL=https://cloud.langfuse.com
