# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# --- IA ----------------------------------------------------------------------
# As API keys de IA NÃO ficam aqui: cada usuário digita a própria chave na
# interface (OpenAI, Anthropic, Gemini, Together ou OpenRouter).
#
# Enquanto a integração real não estiver testada, as rotas devolvem dados de
# exemplo. Para ligar as chamadas reais de IA (e a validação real da chave):
MATCHCV_ENABLE_AI=false

# --- Rate limit (opcional) ---------------------------------------------------
# Sem estas variáveis o limite por IP fica em memória, nesta instância.
# Crie o Redis no Marketplace da Vercel (Upstash) e conecte ao projeto.
# A integração preenche KV_REST_API_URL e KV_REST_API_TOKEN. O par
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN também serve, se o
# par KV_* não estiver completo. Os dois pares não são misturados.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Sal opcional do SHA-256 do IP. Sem ele o IP ainda é hasheado, só que sem sal.
# RATE_LIMIT_IP_SALT=

# --- Telemetria (opcional) ---------------------------------------------------
# Os spans sobem para a observabilidade da Vercel sem estas variáveis.
# O exporter do Langfuse só liga se as três existirem. Sem uma delas, fica desligado.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASEURL=https://cloud.langfuse.com

# --- Conta, banco e chave cifrada (opcionais) --------------------------------
# Sem DATABASE_URL o app segue no modo anônimo: dashboard em localStorage e
# chave salva num cookie HttpOnly cifrado. Better Auth só liga com os dois:
# DATABASE_URL=postgres://usuario:senha@host:5432/matchcv
# BETTER_AUTH_SECRET= troque por 32+ bytes aleatórios (openssl rand -base64 32)
# BETTER_AUTH_URL=http://localhost:3000
# KEK do envelope AES-256-GCM. Se faltar, o desenvolvimento usa BETTER_AUTH_SECRET.
# KEY_ENCRYPTION_SECRET=
# KEY_ENCRYPTION_KEK_VERSION=1
# Ao rotacionar, suba a versão e guarde a KEK anterior para ler chaves já salvas:
# KEY_ENCRYPTION_SECRET_PREVIOUS=
# KEY_ENCRYPTION_SECRET_V1=
# OAuth e e-mail do magic link. Sem eles o login correspondente fica desligado.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM="MatchCV <acesso@seudominio.com>"

# --- Sentry (opcional) -------------------------------------------------------
# Sem SENTRY_DSN e NEXT_PUBLIC_SENTRY_DSN o Sentry fica desligado.
# Crie um projeto Next.js em https://sentry.io e copie o DSN.
# O browser usa NEXT_PUBLIC_SENTRY_DSN e envia pelo túnel /monitoring
# (a CSP continua com connect-src 'self').
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Org e projeto no sentry.io (SaaS). O build usa estes nomes se as variáveis faltarem.
# SENTRY_ORG=amador-gabriel-rc
# SENTRY_PROJECT=match-cv
# Upload de source maps no build. Sem este token o build segue e não envia mapas.
# SENTRY_AUTH_TOKEN=
# Amostra de traces. Padrão 0.1. No navegador só a variável NEXT_PUBLIC_ entra no bundle.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
